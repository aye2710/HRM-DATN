generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. AUTH & SECURITY (Phân quyền)
// ==========================================

model Account {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  employeeId String?  @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  isActive   Boolean  @default(true)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, HR_MANAGER, EMPLOYEE
  description String?
  accounts    Account[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g. VIEW_PAYROLL, EDIT_EMPLOYEE
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  tableName String
  recordId  String
  accountId String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

// ==========================================
// 2. CORE HR (Tổ chức & Nhân sự)
// ==========================================

model Department {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  parentId     String?
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DepartmentHierarchy")
  managerId    String?
  managerName  String?
  quota        Int          @default(15)
  status       String       @default("ACTIVE")
  employees    Employee[]
  positions    Position[]
  jobPostings  JobPosting[]
}

model Position {
  id           String      @id @default(uuid())
  code         String?     @unique
  title        String
  description  String?
  level        String      @default("Staff")
  minSalary    Int         @default(0)
  maxSalary    Int         @default(0)
  status       String       @default("ACTIVE")
  
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  
  employees    Employee[]
  jobPostings  JobPosting[]
}

enum EmployeeStatus {
  ONBOARDING
  INTERNSHIP
  PROBATION
  ACTIVE
  RESIGNED
}

model Employee {
  id             String         @id @default(uuid())
  code           String         @unique 
  fullName       String
  cccd           String         @unique
  status         EmployeeStatus @default(ACTIVE)
  joinDate       DateTime
  
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  
  positionId     String?
  position       Position?      @relation(fields: [positionId], references: [id])

  account        Account?
  contracts      Contract[]
  attendances    Attendance[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  otRequests     OTRequest[]
  payslips       Payslip[]
  reviews        PerformanceReview[]
  kpis           KPI[]
  onboardingTasks OnboardingTask[]
}

model OnboardingTask {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  taskName    String
  category    String   // 'EQUIPMENT', 'ACCOUNT', 'CONTRACT', 'TRAINING'
  isCompleted Boolean  @default(false)
}

enum ContractType {
  INTERNSHIP
  PROBATION
  OFFICIAL_1Y
  INDEFINITE
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id            String         @id @default(uuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  contractType  ContractType
  baseSalary    Decimal
  startDate     DateTime
  endDate       DateTime?
  status        ContractStatus @default(ACTIVE)
}

// ==========================================
// 3. TIME & ATTENDANCE (Chấm công)
// ==========================================

model Shift {
  id        String   @id @default(uuid())
  name      String
  startTime String   // e.g. "08:00"
  endTime   String   // e.g. "17:30"
}

model Holiday {
  id   String   @id @default(uuid())
  date DateTime @db.Date
  name String
}

enum AttendanceStatus {
  NORMAL
  LATE
  ABSENT
}

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  workingDay    Decimal          @default(0) 
  status        AttendanceStatus @default(NORMAL)
}

// ==========================================
// 4. LEAVE MODULE (Nghỉ phép)
// ==========================================

model LeaveBalance {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  year          Int
  totalDays     Decimal  @default(12)
  usedDays      Decimal  @default(0)
}

enum LeaveType {
  PAID
  UNPAID
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType
  startDate     DateTime
  endDate       DateTime
  status        RequestStatus @default(PENDING)
  reason        String?
  approverId    String?
}

// ==========================================
// 5. OVERTIME (Làm thêm giờ)
// ==========================================

model OTRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  date          DateTime      @db.Date
  requestHours  Decimal
  actualHours   Decimal       @default(0) 
  status        RequestStatus @default(PENDING)
  reason        String?
}

// ==========================================
// 6. PAYROLL (Tiền lương)
// ==========================================

enum PayrollStatus {
  DRAFT
  LOCKED
}

model PayrollPeriod {
  id                  String        @id @default(uuid())
  monthYear           String        @unique 
  standardWorkingDays Int           
  status              PayrollStatus @default(DRAFT)
  payslips            Payslip[]
}

model Payslip {
  id                  String        @id @default(uuid())
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriodId     String
  payrollPeriod       PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  
  actualWorkingDays   Decimal
  baseSalary          Decimal
  grossSalary         Decimal
  insuranceDeduction  Decimal       @default(0)
  taxDeduction        Decimal       @default(0)
  leaveClawback       Decimal       @default(0) 
  netSalary           Decimal

  details             PayslipDetail[]
}

model PayslipDetail {
  id          String   @id @default(uuid())
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id])
  type        String   // EARNING or DEDUCTION
  amount      Decimal
  description String
}

model Allowance {
  id          String   @id @default(uuid())
  name        String
  amount      Decimal
  isTaxable   Boolean  @default(false)
}

model TaxBracket {
  id          String   @id @default(uuid())
  tier        Int
  minIncome   Decimal
  maxIncome   Decimal?
  taxRate     Decimal
}

// ==========================================
// 7. RECRUITMENT (Tuyển dụng)
// ==========================================

model JobPosting {
  id           String      @id @default(uuid())
  title        String
  description  String      @db.Text
  amount       Int         @default(1)
  deadline     DateTime?
  status       String      @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  salaryRange  String?
  jobType      String      @default("Full-time")
  level        String?     // Intern, Fresher, Junior, Middle, Senior, Manager
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id])
  
  candidates   Candidate[]
}

model Candidate {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  cvUrl        String?
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])
  status       String   // APPLIED, INTERVIEWING, OFFERED, REJECTED
  interviews   InterviewRound[]
}

model InterviewRound {
  id            String   @id @default(uuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  interviewerId String
  roundName     String
  scheduledAt   DateTime
  feedbacks     CandidateFeedback[]
}

model CandidateFeedback {
  id               String   @id @default(uuid())
  interviewRoundId String
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id])
  score            Int
  comments         String?  @db.Text
}

// ==========================================
// 8. PERFORMANCE (Đánh giá KPI)
// ==========================================

model ReviewCycle {
  id          String   @id @default(uuid())
  name        String   // e.g. Q1 2026
  startDate   DateTime
  endDate     DateTime
  reviews     PerformanceReview[]
}

model KPI {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  description String
  target      Decimal
  achieved    Decimal  @default(0)
}

model PerformanceReview {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  reviewCycleId String
  reviewCycle   ReviewCycle @relation(fields: [reviewCycleId], references: [id])
  score         Decimal
  comments      String?  @db.Text
}
