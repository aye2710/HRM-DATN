generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. AUTH & SECURITY (Phân quyền)
// ==========================================

model Account {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String
  employeeId String?  @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  isActive   Boolean  @default(true)
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, HR_MANAGER, EMPLOYEE
  description String?
  accounts    Account[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique // e.g. VIEW_PAYROLL, EDIT_EMPLOYEE
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  tableName String
  recordId  String
  accountId String
  details   String?  @db.Text
  createdAt DateTime @default(now())
}

// ==========================================
// 2. CORE HR (Tổ chức & Nhân sự)
// ==========================================

model Department {
  id           String       @id @default(uuid())
  code         String       @unique
  name         String
  parentId     String?
  parent       Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DepartmentHierarchy")
  managerId    String?
  managerName  String?
  quota        Int          @default(15)
  status       String       @default("ACTIVE")
  employees    Employee[]
  positions    Position[]
  jobPostings  JobPosting[]
  employmentHistories EmploymentHistory[]
  decisions    Decision[]
}

model Position {
  id           String      @id @default(uuid())
  code         String?     @unique
  title        String
  description  String?
  level        String      @default("Staff")
  minSalary    Int         @default(0)
  maxSalary    Int         @default(0)
  status       String       @default("ACTIVE")
  
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  
  employees    Employee[]
  jobPostings  JobPosting[]
  employmentHistories EmploymentHistory[]
  decisions    Decision[]
}

enum EmployeeStatus {
  ONBOARDING
  INTERNSHIP
  PROBATION
  ACTIVE
  MATERNITY_LEAVE
  UNPAID_LEAVE
  SUSPENDED
  RESIGNED
}

model Employee {
  id             String         @id @default(uuid())
  code           String         @unique 
  fullName       String
  cccd           String?        @unique
  cccdIssueDate  DateTime?
  cccdIssuePlace String?
  cccdExpiryDate DateTime?
  birthPlace     String?
  hometown       String?
  ethnicity      String?
  religion       String?
  dataConsent    Boolean        @default(true)
  dataConsentDate DateTime?
  
  email          String?        @unique
  personalEmail  String?
  phone          String?
  gender         String?        // 'MALE', 'FEMALE', 'OTHER'
  dateOfBirth    DateTime?
  address        String?
  permanentAddress String?
  temporaryAddress String?
  currentAddress   String?
  nationality    String?
  maritalStatus  String?
  taxCode        String?
  bankName       String?
  bankBranch     String?
  bankAccount    String?
  bankAccountHolder String?
  socialInsurance String?
  healthInsurance String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  emergencyContacts String?     @db.Text
  
  highestEducation String?
  workExperience   String?      @db.Text
  attachedFiles    String?      @db.Text
  
  status         EmployeeStatus @default(ACTIVE)
  managementRole String?        @default("STAFF")
  managerId      String?
  manager        Employee?      @relation("DirectManagement", fields: [managerId], references: [id])
  subordinates   Employee[]     @relation("DirectManagement")
  workLocation   String?        @default("Trụ sở chính")
  employmentType String?        @default("FULL_TIME")
  probationStartDate DateTime?
  probationEndDate   DateTime?
  officialJoinDate   DateTime?
  resignationDate    DateTime?
  resignationReason  String?
  
  joinDate       DateTime
  
  departmentId   String?
  department     Department?    @relation(fields: [departmentId], references: [id])
  
  positionId     String?
  position       Position?      @relation(fields: [positionId], references: [id])

  account        Account?
  contracts      Contract[]
  attendances    Attendance[]
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[]
  otRequests     OTRequest[]
  payslips       Payslip[]
  reviews        PerformanceReview[]
  kpis           KPI[]
  onboardingTasks OnboardingTask[]
  relatives      Relative[]
  degrees        Degree[]
  certificates   Certificate[]
  employmentHistories EmploymentHistory[]
  attendanceAdjustments AttendanceAdjustment[]
  decisions           Decision[]
  assetAssignments    AssetAssignment[]
  profileChangeRequests ProfileChangeRequest[]
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfileChangeRequest {
  id            String              @id @default(uuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  requestType   String              @default("PROFILE_UPDATE")
  proposedData  String              @db.Text
  attachmentUrl String?
  note          String?
  
  status        ChangeRequestStatus @default(PENDING)
  rejectReason  String?
  
  reviewedBy    String?
  reviewedAt    DateTime?
  
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum DecisionType {
  SALARY_ADJUSTMENT
  PROMOTION
  TRANSFER
  TERMINATION
  REWARD
  DISCIPLINE
}

enum DecisionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Decision {
  id              String         @id @default(uuid())
  decisionNumber  String         @unique
  title           String
  type            DecisionType
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  
  oldSalary       Decimal?
  newSalary       Decimal?
  
  oldDepartmentId String?
  newDepartmentId String?
  newDepartment   Department?    @relation(fields: [newDepartmentId], references: [id])
  
  oldPositionId   String?
  newPositionId   String?
  newPosition     Position?      @relation(fields: [newPositionId], references: [id])
  
  reason          String?        @db.Text
  effectiveDate   DateTime       @default(now())
  status          DecisionStatus @default(PENDING)
  
  fileUrl         String?        @db.Text
  signBy          String?
  signDate        DateTime?
  
  // Thông tin khen thưởng & kỷ luật có cấu trúc
  rewardAmount        Decimal?
  disciplineForm      String?
  disciplineDuration  String?
  
  // Thông tin thu hồi / đính chính
  revokeReason    String?        @db.Text
  revokedAt       DateTime?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Relative {
  id                String    @id @default(uuid())
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName          String
  relation          String
  dateOfBirth       DateTime?
  taxCode           String?
  isDependent       Boolean   @default(false)
  cccd              String?
  taxDeductionStart DateTime?
  taxDeductionEnd   DateTime?
  proofDocument     String?
}

model Degree {
  id             String    @id @default(uuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  degreeName     String
  major          String
  institution    String
  gradYear       Int?
  classification String?
  fileUrl        String?
}

model Certificate {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name        String
  issuedBy    String
  issueDate   DateTime?
  expiryDate  DateTime?
  fileUrl     String?
}

model OnboardingTask {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  taskName    String
  category    String   // 'EQUIPMENT', 'ACCOUNT', 'CONTRACT', 'TRAINING'
  isCompleted Boolean  @default(false)
}

model EmploymentHistory {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  
  positionId    String?
  position      Position? @relation(fields: [positionId], references: [id])
  
  changeReason  String   // 'NEW_HIRE', 'PROMOTION', 'TRANSFER'
  effectiveDate DateTime @default(now())
  salary        Decimal?
  createdAt     DateTime @default(now())
}

enum ContractType {
  INTERNSHIP
  PROBATION
  OFFICIAL_1Y
  INDEFINITE
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

model Contract {
  id              String         @id @default(uuid())
  contractNumber  String?
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id])
  contractType    ContractType
  baseSalary      Decimal
  allowance       Decimal?       @default(0)
  insuranceSalary Decimal?
  paymentMethod   String?        @default("BANK_TRANSFER")
  startDate       DateTime
  endDate         DateTime?
  signBy          String?
  signDate        DateTime?
  workLocation    String?
  appendixNote    String?        @db.Text
  status          ContractStatus @default(ACTIVE)
  fileUrl         String?        @db.Text
  appendices      ContractAppendix[]
  createdAt       DateTime       @default(now())
}

model ContractAppendix {
  id              String         @id @default(uuid())
  appendixNumber  String
  contractId      String
  contract        Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  decisionId      String?
  title           String
  changeType      String         @default("SALARY_ADJUSTMENT") // 'SALARY_ADJUSTMENT', 'POSITION_CHANGE', 'TERMS_UPDATE'
  oldSalary       Decimal?
  newSalary       Decimal?
  effectiveDate   DateTime       @default(now())
  content         String?        @db.Text
  fileUrl         String?        @db.Text
  createdAt       DateTime       @default(now())
}


// ==========================================
// 3. TIME & ATTENDANCE (Chấm công)
// ==========================================

model Shift {
  id        String   @id @default(uuid())
  name      String
  startTime String   // e.g. "08:00"
  endTime   String   // e.g. "17:30"
  breakTime String?  // e.g. "12:00 - 13:30"
  workHours Decimal  @default(8)
  isActive  Boolean  @default(true)
}

model Holiday {
  id   String   @id @default(uuid())
  date DateTime @db.Date
  name String
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  ON_LEAVE
  HOLIDAY
  ABSENT
}

model Attendance {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  date          DateTime         @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  workingDay    Decimal          @default(0) 
  status        AttendanceStatus @default(NORMAL)
}

model AttendanceAdjustment {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id])
  date         DateTime      @db.Date
  type         String        // 'Thiếu Check-in', 'Thiếu Check-out', 'Sai giờ làm'
  oldTime      String?
  newTime      String
  reason       String
  status       RequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  createdAt    DateTime      @default(now())
}

// ==========================================
// 4. LEAVE MODULE (Nghỉ phép)
// ==========================================

model LeaveBalance {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  year          Int
  totalDays     Decimal  @default(12)
  usedDays      Decimal  @default(0)
}

enum LeaveType {
  PAID
  UNPAID
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType
  session       String?       @default("ALL_DAY") // ALL_DAY, MORNING, AFTERNOON
  startDate     DateTime
  endDate       DateTime
  status        RequestStatus @default(PENDING)
  reason        String?
  approverId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
}

model LeaveTypeConfig {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  defaultDays  Int     @default(12)
  paid         Boolean @default(true)
  carryForward Boolean @default(true)
  status       String  @default("Hoạt động") // Hoạt động, Tạm dừng
}

model LeavePolicy {
  id          String  @id @default(uuid())
  name        String
  type        String
  seniority   String
  extraDays   String
  maxDays     String
}

// ==========================================
// 5. OVERTIME (Làm thêm giờ)
// ==========================================

model OTRequest {
  id            String        @id @default(uuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  date          DateTime      @db.Date
  requestHours  Decimal
  actualHours   Decimal       @default(0) 
  status        RequestStatus @default(PENDING)
  reason        String?
}

// ==========================================
// 6. PAYROLL (Tiền lương)
// ==========================================

enum PayrollStatus {
  DRAFT
  LOCKED
}

model PayrollPeriod {
  id                  String        @id @default(uuid())
  monthYear           String        @unique 
  standardWorkingDays Int           
  status              PayrollStatus @default(DRAFT)
  payslips            Payslip[]
}

model Payslip {
  id                  String        @id @default(uuid())
  employeeId          String
  employee            Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriodId     String
  payrollPeriod       PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  
  actualWorkingDays   Decimal
  baseSalary          Decimal
  grossSalary         Decimal
  insuranceDeduction  Decimal       @default(0)
  taxDeduction        Decimal       @default(0)
  leaveClawback       Decimal       @default(0) 
  netSalary           Decimal

  details             PayslipDetail[]
}

model PayslipDetail {
  id          String   @id @default(uuid())
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id])
  type        String   // EARNING or DEDUCTION
  amount      Decimal
  description String
}

model Allowance {
  id          String   @id @default(uuid())
  name        String
  amount      Decimal
  isTaxable   Boolean  @default(false)
}

model TaxBracket {
  id          String   @id @default(uuid())
  tier        Int
  minIncome   Decimal
  maxIncome   Decimal?
  taxRate     Decimal
}

// ==========================================
// 7. RECRUITMENT (Tuyển dụng)
// ==========================================

model JobPosting {
  id                String      @id @default(uuid())
  title             String
  description       String      @db.Text
  amount            Int         @default(1)
  publishDate       DateTime?
  deadline          DateTime?
  status            String      @default("DRAFT") // DRAFT, PUBLISHED, CLOSED
  salaryRange       String?
  jobType           String      @default("Full-time")
  level             String?     // Intern, Fresher, Junior, Middle, Senior, Manager
  location          String?     @default("Hà Nội")
  workplaceType     String?     @default("On-site") // On-site, Hybrid, Remote
  experienceLevel   String?     @default("Không yêu cầu")
  recruitmentReason String?     @default("EXPANSION") // EXPANSION, REPLACEMENT, PROJECT, CAMPUS
  recruiterName     String?
  targetStartDate   DateTime?
  
  departmentId      String?
  department        Department? @relation(fields: [departmentId], references: [id])
  
  positionId        String?
  position          Position?   @relation(fields: [positionId], references: [id])
  
  candidates        Candidate[]
}

enum CandidateStatus {
  SOURCED
  APPLIED
  SCREENING
  INTERVIEWING
  OFFERING
  HIRED
  REJECTED
}

model Candidate {
  id            String                 @id @default(uuid())
  name          String
  email         String
  phone         String?
  cvUrl         String?
  jobPostingId  String
  jobPosting    JobPosting             @relation(fields: [jobPostingId], references: [id])
  status        CandidateStatus        @default(APPLIED)
  interviews    InterviewRound[]
  offer         JobOffer?
  preOnboarding PreOnboardingProfile?
  createdAt     DateTime               @default(now())

  @@unique([email, jobPostingId])
  @@index([email])
  @@index([jobPostingId])
  @@index([status])
}

model CandidateUser {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  name       String
  phone      String?
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CandidateVerificationOtp {
  id        String   @id @default(uuid())
  email     String   @unique
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PreOnboardingProfile {
  id                       String    @id @default(uuid())
  candidateId              String    @unique
  candidate                Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cccd                     String?
  gender                   String?
  dateOfBirth              DateTime?
  address                  String?
  nationality              String?   @default("Việt Nam")
  maritalStatus            String?
  taxCode                  String?
  bankName                 String?
  bankAccount              String?
  socialInsurance          String?
  healthInsurance          String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  submittedAt              DateTime  @default(now())
}

model InterviewRound {
  id                String   @id @default(uuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id])
  interviewerId     String
  roundName         String
  scheduledAt       DateTime
  status            String   @default("PENDING_CONFIRMATION") // PENDING_CONFIRMATION, CONFIRMED, DECLINED, CANCELLED, COMPLETED
  location          String?  // Offline address or Online Meeting link (Google Meet / Zoom)
  candidateResponse String?  // Candidate notes or decline reason
  respondedAt       DateTime?
  createdAt         DateTime @default(now())
  expiresAt         DateTime? // 24 hours after creation for auto-cancellation
  feedbacks         CandidateFeedback[]
}

model CandidateFeedback {
  id               String   @id @default(uuid())
  interviewRoundId String
  interviewRound   InterviewRound @relation(fields: [interviewRoundId], references: [id])
  score            Int
  comments         String?  @db.Text
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model JobOffer {
  id            String      @id @default(uuid())
  candidateId   String      @unique
  candidate     Candidate   @relation(fields: [candidateId], references: [id])
  baseSalary    Decimal
  probationRate Int         @default(85)
  startDate     DateTime    @db.Date
  contractType  String?     @default("PROBATION")
  notes         String?
  declineReason String?
  respondedAt   DateTime?
  status        OfferStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  expiresAt     DateTime?
}

// ==========================================
// 8. PERFORMANCE (Đánh giá KPI)
// ==========================================

model ReviewCycle {
  id          String   @id @default(uuid())
  name        String   // e.g. Q1 2026
  startDate   DateTime
  endDate     DateTime
  reviews     PerformanceReview[]
}

model KPI {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  description String
  target      Decimal
  achieved    Decimal  @default(0)
}

model PerformanceReview {
  id            String   @id @default(uuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  reviewCycleId String
  reviewCycle   ReviewCycle @relation(fields: [reviewCycleId], references: [id])
  score         Decimal
  comments      String?  @db.Text
}

model KPITemplate {
  id          String   @id @default(uuid())
  name        String
  department  String
  criteria    Int
  weight      String
  status      String   @default("Active")
}

// ==========================================
// 9. ASSET MANAGEMENT (Quản lý tài sản & thiết bị)
// ==========================================

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  PHONE
  ACCESS_CARD
  OFFICE_EQUIPMENT
  VEHICLE
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  DISPOSED
  LOST
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  DAMAGED
  LOST
}

model Asset {
  id              String            @id @default(uuid())
  code            String            @unique
  name            String
  category        AssetCategory     @default(LAPTOP)
  serialNumber    String?
  price           Decimal           @default(0)
  purchaseDate    DateTime?
  supplier        String?
  status          AssetStatus       @default(AVAILABLE)
  condition       String?           @default("Mới 100%")
  location        String?           @default("Kho CNTT - Tầng 5")
  notes           String?           @db.Text
  isDeleted       Boolean           @default(false)
  assignments     AssetAssignment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model AssetAssignment {
  id                 String           @id @default(uuid())
  assetId            String?
  asset              Asset?           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedDate       DateTime         @default(now())
  returnedDate       DateTime?
  status             AssignmentStatus @default(ACTIVE)
  conditionOnAssign  String?          @default("Hoạt động tốt, nguyên tem bảo hành")
  conditionOnReturn  String?
  handoverDocCode    String?
  compensationAmount Decimal?         @default(0)
  compensationReason String?          @db.Text
  securityWiped      Boolean          @default(true)
  dataWipeNotes      String?          @db.Text
  notes              String?          @db.Text
  itemsJson          String?          @db.Text
  handoverPerson     String?          @default("Đỗ Thị Nguyệt")
  handoverPersonRole String?          @default("Hành chính - Kế toán")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ==========================================
// 10. SYSTEM BUSINESS PARAMETERS (Tham số động)
// ==========================================

model SystemSetting {
  id          String   @id @default(uuid())
  category    String   // PAYROLL, ATTENDANCE, HR, GENERAL
  key         String   @unique
  name        String
  value       String
  dataType    String   @default("NUMBER") // NUMBER, STRING, BOOLEAN, PERCENT
  description String?  @db.Text
  unit        String?
  updatedAt   DateTime @updatedAt
}
